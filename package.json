{
  "name": "schoolsoft-mcp-server",
  "version": "0.1.0",
  "description": "Unofficial MCP server for SchoolSoft (guardian access via BankID)",
  "main": "dist/index.js",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "test:e2e": "SCHOOLSOFT_E2E=1 tsx --test 'test/e2e/*.e2e.test.ts'",
    "typecheck": "tsc -p tsconfig.test.json",
    "e2e:login": "tsx scripts/e2e-login.ts"
  },
  "keywords": [],
  "author": "Jonas Grimfelt",
  "license": "MIT",
  "dependencies": {
    "@elias4044/ssp-node": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "schoolsoft-mcp-server": "dist/index.js"
  }
}
