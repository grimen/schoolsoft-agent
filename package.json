{
  "name": "schoolsoft-agent",
  "version": "0.2.0",
  "description": "SchoolSoft for AI agents (independent project, not affiliated with SchoolSoft AB): MCP server and CLI/skill for guardians — BankID login, schedule, lunch, news, messages",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsx --test 'test/unit/**/*.test.ts' 'test/boundary/**/*.test.ts' 'test/functional/**/*.test.ts' 'test/packaging/**/*.test.ts'",
    "test:e2e": "SCHOOLSOFT_E2E=1 tsx --test --test-concurrency=1 'test/e2e/*.e2e.test.ts'",
    "coverage": "c8 --config .c8rc.json tsx --test 'test/unit/**/*.test.ts' 'test/boundary/**/*.test.ts' 'test/functional/**/*.test.ts' 'test/packaging/**/*.test.ts'",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "boundaries": "tsx scripts/check-boundaries.ts",
    "docs": "tsx scripts/gen-docs.ts",
    "skills": "tsx scripts/gen-skills.ts",
    "plugin:validate": "tsx scripts/validate-plugins.ts",
    "dev": "tsx src/mcp/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/mcp/index.ts",
    "e2e:login": "tsx scripts/e2e-login.ts",
    "prepack": "npm run build",
    "lint": "oxlint --max-warnings=0 src test scripts",
    "prepare": "lefthook install",
    "coverage:badge": "node scripts/coverage-badge.mjs",
    "check:package": "publint"
  },
  "keywords": [
    "schoolsoft",
    "mcp",
    "agent",
    "skill",
    "bankid",
    "claude",
    "opencode"
  ],
  "author": "Jonas Grimfelt",
  "license": "MIT",
  "dependencies": {
    "@elias4044/ssp-node": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.4.0",
    "audit-ci": "^7.1.0",
    "badge-maker": "^6.0.0",
    "c8": "^10.1.3",
    "lefthook": "^2.1.12",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "prettier": "^3.6.2",
    "publint": "^0.3.24",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "schoolsoft-agent": "dist/cli/index.js",
    "schoolsoft-agent-mcp": "dist/mcp/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/mcpb",
    "!dist/skills",
    "!dist/**/*.map",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grimen/schoolsoft-agent.git"
  },
  "homepage": "https://github.com/grimen/schoolsoft-agent#readme",
  "bugs": {
    "url": "https://github.com/grimen/schoolsoft-agent/issues"
  },
  "pi": {
    "skills": [
      "skills/schoolsoft"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/core/index.d.ts",
  "optionalDependencies": {
    "playwright": "^1.63.0"
  }
}
