# EditorConfig: https://editorconfig.org (prettier reads .prettierrc; these
# defaults match it: 2-space, LF, final newline)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: a trailing double-space is a hard line break
[*.md]
trim_trailing_whitespace = false

# Makefiles require tabs
[Makefile]
indent_style = tab
